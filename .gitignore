# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# lockfiles from the other package managers. package-lock.json is the one
# lockfile here and stays tracked; these are ignored so that someone running
# `yarn install` out of habit on a box leaves an untracked file instead of a
# dirty tree that aborts the next `git pull`.
yarn.lock
pnpm-lock.yaml

# testing
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
refresh-osm.log
refresh-officials.log
refresh-social-handles.log
seed-all.log

# local env files
.env
.env*.local

# user profile data (contains real user PII — never commit)
/data/profiles.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
